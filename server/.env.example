# 复制此文件为 .env 后按需修改

# 应用
PROJECT_NAME=QueryAgentService
API_V1_STR=/api/v1

# 跨域来源，JSON 数组，可包含多个来源
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# 数据库连接地址（开发默认 SQLite，生产建议切换 MySQL/PostgreSQL）
DATABASE_URL=sqlite:///./queryagent.db

# JWT 密钥：生产环境务必改为随机值，例如执行
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-please-generate-a-random-64-chars-string
# 令牌有效期（分钟），默认 1440（24 小时）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 大模型配置（OpenAI 兼容接口，默认示例为 DeepSeek）
# API Key 在对应平台控制台获取，切勿提交到代码库
# DeepSeek：LLM_BASE_URL=https://api.deepseek.com  LLM_MODEL=deepseek-chat / deepseek-reasoner
# ModelScope：LLM_BASE_URL=https://api-inference.modelscope.cn/v1  LLM_MODEL=Qwen/Qwen3.8-27B
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
